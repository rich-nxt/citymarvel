local function carregarAsset(id)

    local sucesso, asset = pcall(function()
        return InsertService:LoadAsset(id)
    end)

    if sucesso and asset then
        return asset
    end

    local sucesso2, asset2 = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)[1]
    end)

    if sucesso2 and asset2 then
        return asset2
    end

    return nil

end

local function posicionar(modelo, posicao, offset, rotacao)

    rotacao = rotacao or Vector3.new(0,0,0)

    if modelo:IsA("Model") then

        local _, tamanho = modelo:GetBoundingBox()

        modelo:PivotTo(
            CFrame.new(
                posicao.X,
                posicao.Y + (tamanho.Y / 2) + offset,
                posicao.Z
            ) * CFrame.Angles(
                math.rad(rotacao.X),
                math.rad(rotacao.Y),
                math.rad(rotacao.Z)
            )
        )

    else

        local part = modelo:IsA("BasePart") and modelo
            or modelo:FindFirstChildWhichIsA("BasePart")

        if part then

            part.CFrame = CFrame.new(
                posicao.X,
                posicao.Y + (part.Size.Y / 2) + offset,
                posicao.Z
            ) * CFrame.Angles(
                math.rad(rotacao.X),
                math.rad(rotacao.Y),
                math.rad(rotacao.Z)
            )

        end

    end

end

for _, info in ipairs(modelos) do

    local assetOriginal = carregarAsset(info.id)

    if assetOriginal then

        for _, pos in ipairs(info.posicoes) do

            local clone = assetOriginal:Clone()
            clone.Parent = workspace

            posicionar(clone, pos, info.offset, info.rotacao)

        end

        assetOriginal:Destroy()
        print("Modelo carregado:", info.id)

    else

        warn("Falha ao carregar modelo:", info.id)

    end

end

